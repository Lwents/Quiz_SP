# Backend configuration
PROJECT_NAME="Quiz_SP System"
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quiz_db
# Generate a private value, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Integration
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=ag/gemini-3.8-flash-high

# Frontend configuration
VITE_API_URL=http://localhost:8000/api/v1

# Shared API/media upstream for Docker frontend and Vite dev server.
# A path prefix is supported; omit the trailing slash.
BACKEND_UPSTREAM=
